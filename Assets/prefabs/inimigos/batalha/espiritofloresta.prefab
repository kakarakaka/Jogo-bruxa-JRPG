  m_Script: {fileID: 11500000, guid: c947797067f397b4984c22fb5aa5e725, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalBossEnding
  guardianBook: {fileID: 11400000, guid: 0681a4e5ed6e4f34ca10040ea605b23b, type: 2}
  normalImage: {fileID: 2800000, guid: 6945b44266b69924890a5a016a4d6793, type: 3}
  normalLines:
  - "Ap\xF3s derrotar o esp\xEDrito da floresta, a bruxa conseguiu roubar o seu poder
    e virar a rainha da floresta.\r\n"
  - Um final feliz para a bruxinha.
  - Final 1 /2.
  secretImage: {fileID: 2800000, guid: cbcbf236f29898a4a980c0d861af5a68, type: 3}
  secretLines:
  - "A jovem bruxa n\xE3o apenas conseguiu roubar os poderes do esp\xEDrito da floresta,
    mas tamb\xE9m conseguiu o tomo proibido da caverna dos sussurros.\r\n"
  - "Com todo esse poder a bruxinha \xE9 invenc\xEDvel. "
  - Seu objetivo deixou de ser a rainha apenas da floresta, mas agora de todo o mundo.
  - "A bruxinha n\xE3o poderia estar mais feliz."
  - Final 2 /2.
